<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071316"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    tools:context=".MainActivity">


    <!-- ============================= -->
    <!-- Main Login Container -->
    <!-- ============================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loginContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ============================= -->
        <!-- Logo Circle -->
        <!-- ============================= -->

        <TextView
            android:id="@+id/logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/logo"
            android:gravity="center"
            android:textColor="#66E0E0"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ============================= -->
        <!-- App Connect -->
        <!-- ============================= -->

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="App Connect"
            android:textColor="#E8EEEE"
            android:textSize="22sp"
            android:fontFamily="sans"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ============================= -->
        <!-- Welcome -->
        <!-- ============================= -->

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Welcome back!"
            android:textColor="#E8EEEE"
            android:textSize="25sp"
            android:textStyle="normal"
            android:fontFamily="sans"
            app:layout_constraintTop_toBottomOf="@id/appName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ============================= -->
        <!-- Username Label -->
        <!-- ============================= -->

        <TextView
            android:id="@+id/emailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="17dp"
            android:background="#071316"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Email or Username"
            android:textColor="#70C5C8"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/welcomeText"
            app:layout_constraintStart_toStartOf="@id/emailBox" />


        <!-- ============================= -->
        <!-- Username Box -->
        <!-- ============================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/emailBox"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/welcomeText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/emailIcon"
                android:layout_width="15dp"
                android:layout_height="22dp"
                android:background="@drawable/username_24"
                android:gravity="center"
                android:textColor="#70C5C8"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="johndoe@email.com"
                android:inputType="textEmailAddress"
                android:paddingStart="2dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#E8EEEE"
                android:textColorHint="#B4BDBD"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@id/emailIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ============================= -->
        <!-- Password Label -->
        <!-- ============================= -->

        <TextView
            android:id="@+id/passwordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="18dp"
            android:background="#071316"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Password"
            android:textColor="#9DA7A8"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/emailBox"
            app:layout_constraintStart_toStartOf="@id/passwordBox" />


        <!-- ============================= -->
        <!-- Password Box -->
        <!-- ============================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/passwordBox"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/emailBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/passwordIcon"
                android:layout_width="15dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:background="@drawable/password_24"
                android:textColor="#9DA7A8"
                android:textSize="19sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Password eye -->
            <ImageButton
                android:id="@+id/passwordEye"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:padding="9dp"
                android:src="@drawable/eye_24"
                android:scaleType="centerInside"
                android:contentDescription="Show password"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Password eye -->
            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="••••••••••"
                android:inputType="textPassword"
                android:paddingStart="2dp"
                android:paddingEnd="42dp"
                android:singleLine="true"
                android:textColor="#E8EEEE"
                android:textColorHint="#B4BDBD"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@id/passwordIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ============================= -->
        <!-- Login Button -->
        <!-- ============================= -->
        <!-- ============================= -->
        <!-- Login Button -->
        <!-- ============================= -->

        <Button
            android:id="@+id/loginButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#70C5C8"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Log In"
            android:textAllCaps="false"
            android:textColor="#071316"
            android:textSize="15sp"
            android:fontFamily="sans"

            app:layout_constraintTop_toBottomOf="@id/passwordBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ============================= -->
        <!-- Forgot Password -->
        <!-- ============================= -->

        <TextView
            android:id="@+id/forgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Forgot Password?"
            android:textColor="#70C5C8"
            android:textSize="14sp"
            android:textStyle="normal"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/loginButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>